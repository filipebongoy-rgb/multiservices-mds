# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=

# Authentication / sessions
JWT_SECRET=
MANUS_JWT_SECRET=

# Stripe — test first, live only after explicit validation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email — optional
MDS_RESEND_API_KEY=
MDS_EMAIL_FROM=

# Twilio Voice — optional, disabled until fully configured
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE_NUMBER=

# Maps — optional client-side public token
VITE_MAPBOX_TOKEN=

# Visit counting salt
MDS_VISIT_SALT=

# Planification hors Manus — secret d'au moins 32 caracteres, appele par un cron gratuit
MDS_CRON_SECRET=

# Premier lancement uniquement : 1 pour charger le catalogue, puis retirer
MDS_SEED_ON_START=
